# Local development uses localhost. Production must use the public hostname
# and the same origin with an https scheme.
SITE_ADDRESS=localhost
WEB_ORIGIN=http://localhost:3000

POSTGRES_DB=accountant
POSTGRES_USER=accountant
POSTGRES_PASSWORD=accountant_dev_password

JWT_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
APP_TIMEZONE=Europe/Istanbul

RATE_LIMIT_ENABLED=true
LOGIN_MAX_ATTEMPTS=5
LOGIN_IP_MAX_ATTEMPTS=30
LOGIN_WINDOW_SECONDS=900
REGISTER_MAX_ATTEMPTS=5
REGISTER_WINDOW_SECONDS=3600
PASSWORD_RESET_MAX_ATTEMPTS=3
PASSWORD_RESET_IP_MAX_ATTEMPTS=10
PASSWORD_RESET_WINDOW_SECONDS=3600
PASSWORD_RESET_TOKEN_MINUTES=60
DAILY_SUMMARY_CATCHUP_DAYS=3
EMAIL_CHANGE_MAX_ATTEMPTS=3
EMAIL_CHANGE_WINDOW_SECONDS=3600
EMAIL_CHANGE_TOKEN_MINUTES=60

CACHE_TTL_SECONDS=300

MAIL_USERNAME=
MAIL_APP_PASSWORD=
MAIL_FROM_NAME=Accountant
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=587
